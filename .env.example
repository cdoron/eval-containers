# Eval Containers configuration
# Copy to .env and fill in your values:  cp .env.example .env

# Executor gateway endpoint and credential
OPENAI_API_BASE=https://executor.example.com/v1
OPENAI_API_KEY=replace-with-executor-key

# OpenCode advisor endpoint and credential. These are independent from the
# executor values above; set them explicitly even when both use one endpoint.
ADVISOR_BASE_URL=https://advisor.example.com/v1
ADVISOR_API_KEY=replace-with-advisor-key

# Optional provider-native credential for models that require it
ANTHROPIC_API_KEY=sk-ant-...

# Registry: where images and compose files are stored
# Default: ghcr.io/eval-containers (production)
# For local development: localhost:5000
EVAL_REGISTRY=ghcr.io/eval-containers

# Default agent and model (can be overridden per run)
EVAL_AGENT=claude-code
EVAL_MODEL=claude-sonnet-4

# Default timeout in seconds (can be overridden per run or per benchmark)
EVAL_TIMEOUT=300

# Hard cap on model spend in USD per run. The litellm proxy enforces
# it and crashes the run (BudgetExceededError) once crossed. Default $1
# is strict on purpose — bump after observing real runs. Overridable
# via `eval-containers run --max-budget <N>`.
EVAL_MODEL_MAX_BUDGET=1

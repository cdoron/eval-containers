#!/bin/bash
# Launch the agent under the eval's isolation contract. Shared by BOTH
# orchestration paths so the env allow-list has exactly one home:
#   - single-container bundle: process-compose.yaml's `agent` process runs this;
#   - compose/k8s lean base:   the runner sequence in /usr/local/bin/run runs this.
#
# Contract enforced here:
#   - non-root: `gosu agent` drops to the unprivileged agent uid (rule 13);
#   - bounded:  `timeout -k 30 $TIMEOUT` caps the agent's wall-clock (rule 14).
#     `-k 30` force-kills (SIGKILL) 30s after the initial SIGTERM if the agent
#     process ignores or outlives it — without it, an agent that doesn't die on
#     SIGTERM (observed with Node-based agents) keeps running past $TIMEOUT with
#     no enforced cutoff, producing a truncated/ambiguous trace instead of a
#     clean timeout;
#   - scrubbed: `env -i <allow-list>` hands the agent ONLY the problem text,
#     the gateway endpoints, and advisory config — never the task IDENTITY
#     (TASK_ID). A model that recognizes a benchmark instance id can recall
#     a memorized solution and inflate the score; the verifier/result steps
#     read the id from the
#     inherited container env, so grading is unaffected (rule 7).
#
# Fail loud if EVAL_AGENT_REASONING_EFFORT is set but the agent's entrypoint
# doesn't reference it — a supported agent declares itself by using the var.
if [ -n "${EVAL_AGENT_REASONING_EFFORT:-}" ] && ! grep -q EVAL_AGENT_REASONING_EFFORT /run.sh; then
  echo "run-agent: EVAL_AGENT_REASONING_EFFORT is set but agent '${EVAL_AGENT:-?}' does not support it" >&2
  exit 2
fi

# Prompt additions are runtime choices. A benchmark may ship a default hint at
# /opt/benchmark/prompt-hint.txt, but merely having that file never changes the
# task. The selected text is prepended here so the same contract works for every
# benchmark and agent without putting experiment policy in benchmark Compose.
prompt_prefix=""
case "${EVAL_PROMPT_HINT_MODE:-none}" in
  none|"") ;;
  default)
    hint_file="${EVAL_PROMPT_HINT_FILE:-/opt/benchmark/prompt-hint.txt}"
    if [ ! -s "$hint_file" ]; then
      echo "run-agent: default prompt hint requested but '$hint_file' is missing or empty" >&2
      exit 2
    fi
    prompt_prefix="$(cat "$hint_file")"
    ;;
  custom)
    if [ -z "${EVAL_PROMPT_HINT:-}" ]; then
      echo "run-agent: custom prompt hint requested but EVAL_PROMPT_HINT is empty" >&2
      exit 2
    fi
    prompt_prefix="$EVAL_PROMPT_HINT"
    ;;
  *)
    echo "run-agent: invalid EVAL_PROMPT_HINT_MODE '${EVAL_PROMPT_HINT_MODE}' (expected none, default, or custom)" >&2
    exit 2
    ;;
esac

# Advisor usage policy is separate from the tool description. New runs default
# to no advisor mention.
advisory_policy="${ADVISORY_PROMPT_POLICY:-none}"
case "$advisory_policy" in
  none) ;;
  mandatory-first-last)
    policy_file="/opt/agent/advisory/prompt-policies/mandatory-first-last.txt"
    if [ ! -s "$policy_file" ]; then
      echo "run-agent: advisory prompt policy requested but '$policy_file' is missing or empty" >&2
      exit 2
    fi
    if [ -n "$prompt_prefix" ]; then prompt_prefix="${prompt_prefix}

$(cat "$policy_file")"; else prompt_prefix="$(cat "$policy_file")"; fi
    ;;
  *)
    echo "run-agent: invalid ADVISORY_PROMPT_POLICY '$advisory_policy' (expected none or mandatory-first-last)" >&2
    exit 2
    ;;
esac

if [ -n "$prompt_prefix" ]; then
  TASK="${prompt_prefix}

${TASK:-}"
fi

# stdout/stderr go straight to /output/agent/{stdout,stderr}.log (raw, not via
# process-compose's JSON log envelope, which breaks verifiers reading stdout).
# Every value is read from the inherited environment — exported by
# /usr/local/bin/run (single-container) or set by the orchestrator (compose/k8s).
#
# Not exec'd: record the exit status for write-result (rule 16). 124 = timeout.
rc=0
timeout -k 30 "${TIMEOUT:-300}" gosu agent env -i \
  PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
  HOME=/home/agent USER=agent LANG=C.UTF-8 \
  TASK="${TASK:-}" MODEL="${MODEL:-}" TIMEOUT="${TIMEOUT:-300}" \
  EVAL_AGENT_REASONING_EFFORT="${EVAL_AGENT_REASONING_EFFORT:-}" \
  OPENAI_BASE_URL="${OPENAI_BASE_URL:-}" OPENAI_API_KEY=sk-proxy \
  ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-}" ANTHROPIC_API_KEY=sk-proxy \
  GOOGLE_GEMINI_BASE_URL="${GOOGLE_GEMINI_BASE_URL:-}" GEMINI_API_KEY=sk-proxy \
  ADVISORY_GATEWAY_URL="${ADVISORY_GATEWAY_URL:-}" \
  ADVISOR_TOOL_DESCRIPTION_VARIANT="${ADVISOR_TOOL_DESCRIPTION_VARIANT:-}" \
  ADVISOR_TOOL_DESCRIPTION="${ADVISOR_TOOL_DESCRIPTION:-}" \
  ADVISORY_EXPERIMENT_ID="${ADVISORY_EXPERIMENT_ID:-}" \
  /run.sh > /output/agent/stdout.log 2> /output/agent/stderr.log || rc=$?
printf '%s' "$rc" > /output/agent/.exit-code
exit "$rc"

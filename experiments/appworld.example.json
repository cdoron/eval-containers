{
  "$schema": "./schema.json",
  "defaults": {
    "benchmark": "appworld",
    "task_id": "6",
    "agent": "opencode-advisory",
    "executor_model": "aws/claude-haiku-4-5",
    "gateway_image": "litellm",
    "platform": "linux/amd64",
    "mode": "compose",
    "local": true,
    "advisory_config_file": "experiments/advisory-config.example.json",
    "executor_system_prompt_variant": "appworld-task-completion",
    "advisor": {
      "model": "aws/claude-opus-4-8",
      "tool_description_variant": "neutral",
      "system_prompt_variant": "strategic-default",
      "log_payloads": false
    }
  },
  "runs": [
    {"experiment_id": "neutral"},
    {"experiment_id": "encouraging", "advisor": {"tool_description_variant": "encouraging"}},
    {
      "experiment_id": "mandatory-first-last",
      "advisor": {
        "tool_description_variant": "mandatory",
        "system_prompt_variant": "strategic-default"
      },
      "executor_system_prompt_variant": "mandatory-first-last"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval Containers experiment",
  "type": "object",
  "required": ["benchmark", "task_id", "agent", "executor_model"],
  "properties": {
    "$schema": {"type": "string"},
    "benchmark": {"type": "string"},
    "task_id": {"type": ["string", "integer"]},
    "agent": {"type": "string"},
    "executor_model": {"type": "string"},
    "gateway_image": {"type": "string"},
    "platform": {"type": "string"},
    "mode": {"enum": ["compose", "container", "job"]},
    "local": {"type": "boolean"},
    "timeout": {"type": "integer", "minimum": 1},
    "max_budget": {"type": "number", "minimum": 0},
    "agent_reasoning_effort": {"type": "string"},
    "experiment_id": {"type": "string"},
    "executor_system_prompt": {"type": "string", "minLength": 1},
    "executor_system_prompt_file": {"type": "string", "minLength": 1},
    "executor_system_prompt_variant": {"type": "string", "minLength": 1},
    "advisory_config": {
      "oneOf": [
        {"$ref": "#/$defs/advisoryConfig"},
        {"type": "string", "minLength": 2}
      ]
    },
    "advisory_config_file": {"type": "string", "minLength": 1},
    "advisor": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "base_url": {"type": "string"},
        "tool_description_variant": {"type": "string"},
        "tool_description": {"type": "string"},
        "tool_description_file": {"type": "string", "minLength": 1},
        "system_prompt": {"type": "string", "minLength": 1},
        "system_prompt_file": {"type": "string", "minLength": 1},
        "system_prompt_variant": {"type": "string", "minLength": 1},
        "context_mode": {"enum": ["agent-provided", "full-session"]},
        "full_context_max_bytes": {"type": "integer", "minimum": 0},
        "log_payloads": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "advisoryConfig": {
      "type": "object",
      "properties": {
        "executor_system_prompts": {"$ref": "#/$defs/namedTexts"},
        "advisor_system_prompts": {"$ref": "#/$defs/namedTexts"},
        "tool_descriptions": {"$ref": "#/$defs/namedTexts"}
      },
      "additionalProperties": false
    },
    "namedTexts": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
